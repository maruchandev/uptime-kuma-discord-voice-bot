DISCORD_BOT_TOKEN=
# Optional; the server is detected from the voice channel.
DISCORD_GUILD_ID=
# Optional; leave blank for voice-only operation.
DISCORD_TEXT_CHANNEL_ID=
DISCORD_VOICE_CHANNEL_ID=
WEBHOOK_TOKEN=replace-with-a-long-random-value

# Docker user-defined network shared with Uptime Kuma.
KUMA_DOCKER_NETWORK=uptime-kuma-tts

# Optional monitor-list sync through Uptime Kuma's internal Socket.IO API.
# Use the Kuma service name on the shared Docker network.
KUMA_SOCKET_URL=http://uptime-kuma:3001
KUMA_USERNAME=
KUMA_PASSWORD=

# Stream UI bind address/port. Keep loopback for a local-only UI.
STREAM_BIND_ADDRESS=127.0.0.1
STREAM_PORT=3100

PORT=3000
VOICEVOX_URL=http://voicevox:50021
VOICEVOX_SPEAKER_ID=3
VOICEVOX_SPEED_SCALE=1.05
TIMEZONE=Asia/Tokyo
DEDUP_SECONDS=60
# Log a warning when the announcement queue reaches this size; alerts are preserved.
MAX_QUEUE_SIZE=30
ALERT_BATCH_WINDOW_SECONDS=5
ALERT_BATCH_THRESHOLD=3

# Optional initial pronunciations. You can also manage these from /Stream.
# READING_MAP_JSON={"router-01":"ルーター ゼロワン"}
READING_MAP_JSON={}
